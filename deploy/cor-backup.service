[Unit]
Description=C.O.R. encrypted PostgreSQL backup

[Service]
Type=oneshot
User=cor-backup
Group=cor-backup
WorkingDirectory=/opt/cor
EnvironmentFile=/etc/cor/backup.env
ExecStart=/usr/bin/node --import tsx scripts/backup.ts backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/cor
UMask=0077
