# Development is bound to loopback. Demo data never touches Google.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PORT=3001
# Containers override this internally; publish only loopback on the host.
LISTEN_HOST=127.0.0.1
# Linux may use a permission-controlled socket shared only with cloudflared.
HTTP_SOCKET=
DEMO_MODE=true
# Generate independent random secrets; required in production.
SESSION_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=postgresql://cor:CHANGE_ME@localhost:5432/cor
OWNER_EMAIL=
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
# cloudflare: verify Access identity; google: owner-only application login.
AUTH_MODE=cloudflare
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/oauth/callback
# AGY remains disabled until evidence and isolation checks are complete.
AGY_ENABLED=false
AGY_APPROVAL_EVIDENCE=
AGY_LINUX_VERIFIED=false
AGY_ISOLATION_VERIFIED=false
AGY_COMMAND=agy
# Native Linux broker keeps the model process under a separate OS identity.
AGY_SOCKET=
AGY_WORKDIR=
AGY_MODEL=
AGY_TIMEOUT_MS=90000
# Telegram: only the configured numeric owner may send commands.
# Optional negative chat ID restricts commands and notifications to one group.
# BotFather token is a transport credential, NOT a paid LLM API key.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
# Telegram settings may instead be managed in the owner UI (encrypted in PostgreSQL).
# Optional search module: docker compose -f compose.research.yaml up -d
SEARXNG_IMAGE=
SEARXNG_SECRET=
# Offline Turkish speech decoding. Provision the model once, then no API calls.
STT_ENABLED=false
STT_PYTHON=python
STT_MODEL_PATH=
